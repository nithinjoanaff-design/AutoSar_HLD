# ============================================================
# AUTOSAR HLD Assistant - Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env to version control.
# ============================================================

# --- LLM Provider Selection ---
# Supported values: "openrouter", "ollama", "openai", "anthropic", "none"
# - "openrouter" : Access 200+ models (Claude, Llama 3, Gemini, Mistral, DeepSeek) including free tiers.
# - "ollama"     : Connect to local or cloud-hosted Ollama instances.
# - "openai"     : Direct OpenAI API (GPT-4o, GPT-3.5-turbo, etc.).
# - "anthropic"  : Direct Anthropic API (Claude 3.5 Sonnet, Claude 3 Haiku).
# - "none"       : 100% Local Extractive Evidence Mode (no API key needed).
LLM_PROVIDER=none

# ============================================================
# 1. OpenRouter Configuration (LLM_PROVIDER=openrouter)
# Sign up at: https://openrouter.ai/keys
# ============================================================
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Popular & Free OpenRouter Models:
# - "meta-llama/llama-3.3-70b-instruct:free"   (Free, excellent technical reasoning)
# - "google/gemini-2.0-flash-exp:free"          (Free, very fast and human-friendly)
# - "google/gemini-2.5-flash"                  (Fast, cost-effective, high quality)
# - "anthropic/claude-3.5-sonnet"              (Top-tier engineering synthesis)
# - "deepseek/deepseek-r1:free"                (Free, strong technical problem solving)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SITE_URL=https://github.com/autosar-hld-assistant
OPENROUTER_APP_NAME=AUTOSAR HLD Assistant

# ============================================================
# 2. Ollama Configuration (LLM_PROVIDER=ollama)
# Local: install from https://ollama.com and run: ollama run llama3.2
# Cloud: provide your remote Ollama host/endpoint and auth token
# ============================================================
# For local Ollama:
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.2
# Examples for Ollama models: "llama3.2", "mistral", "deepseek-r1:8b", "qwen2.5:7b"
# For remote/cloud Ollama: set OLLAMA_BASE_URL=https://your-ollama-cloud-host/v1

# ============================================================
# 3. OpenAI Configuration (LLM_PROVIDER=openai)
# ============================================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo

# ============================================================
# 4. Anthropic Configuration (LLM_PROVIDER=anthropic)
# ============================================================
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ============================================================
# 5. Local Embedding & Re-ranking Models
# ============================================================
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ============================================================
# 6. Chunking & Retrieval Parameters
# ============================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=5
INDEX_DIR=data/faiss_index
